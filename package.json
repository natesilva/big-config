{
  "name": "big-config",
  "version": "7.0.0",
  "description": "Easily manage configuration settings for small to very large projects",
  "repository": "natesilva/big-config",
  "license": "BSD-3-Clause",
  "author": "Nate Silva <nate@natesilva.com>",
  "keywords": [
    "conf",
    "config",
    "configuration",
    "env",
    "environment",
    "json",
    "yaml"
  ],
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "bin": "dist/cli.mjs",
  "scripts": {
    "clean": "del-cli dist",
    "build": "tsdown",
    "prepublishOnly": "bun build",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "tsc && biome check .",
    "lint:fix": "tsc && biome check --fix ."
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "^1.3.14",
    "@types/js-yaml": "^4.0.5",
    "@types/lodash": "^4.14.191",
    "del-cli": "^7.0.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "js-yaml": "^4.1.0",
    "json5": "^2.2.3",
    "lodash": "^4.17.21",
    "pkg-dir": "^9.0.0",
    "type-fest": "^5.6.0"
  }
}
