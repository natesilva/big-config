{
  "name": "big-config",
  "version": "6.2.0",
  "description": "Easily manage configuration settings for small to very large projects",
  "repository": "natesilva/big-config",
  "license": "BSD-3-Clause",
  "author": "Nate Silva <nate@natesilva.com>",
  "keywords": [
    "conf",
    "config",
    "configuration",
    "env",
    "environment",
    "json",
    "yaml"
  ],
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "bin": "build/src/cli.js",
  "scripts": {
    "clean": "del-cli build",
    "build": "tsc",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "tsc && biome check .",
    "lint:fix": "tsc  --noEmit && biome check --fix .",
    "prepublishOnly": "tsc --noEmit",
    "postpublish": "del-cli build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "^1.3.14",
    "@types/js-yaml": "^4.0.5",
    "@types/lodash": "^4.14.191",
    "del-cli": "^5.0.0",
    "np": "^7.6.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "commander": "^9.5.0",
    "js-yaml": "^4.1.0",
    "json5": "^2.2.3",
    "lodash": "^4.17.21",
    "pkg-dir": "^5.0.0",
    "type-fest": "^3.6.0"
  }
}
